---
interface Props {
  title: string;
  lede?: string;
}
const { title, lede } = Astro.props;
---

<section class="pt-16 sm:pt-24 lg:pt-44 pb-5 sm:pb-10 lg:pb-20 border-b border-line">
  <div class="mx-auto max-w-shell px-4 sm:px-6 lg:px-10">
    <h1 id="h1" class="font-display font-black tracking-[-0.045em] leading-[0.9] text-[clamp(1.95rem,7vw,5.5rem)] max-w-[16ch]">
      <span class="line"><span class="spot">{title}</span></span>
    </h1>
    {lede && (
      <p class="tint rv mt-2.5 sm:mt-6 text-[14px] sm:text-[16.5px] text-ash leading-relaxed max-w-[50ch]">{lede}</p>
    )}
  </div>
</section>
