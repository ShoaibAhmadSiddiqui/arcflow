---
import { site, nav } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="border-t border-line">
  <div class="mx-auto max-w-shell px-4 sm:px-6 lg:px-10 py-6 sm:py-12">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-4 sm:gap-10">
      <div class="md:col-span-5">
        <span class="font-display font-black tracking-[-0.045em] text-[17px] sm:text-[19px]">{site.name.toUpperCase()}</span>
        <p class="tint mt-1.5 sm:mt-4 text-[13px] sm:text-[14px] text-ash leading-relaxed max-w-[38ch]">{site.tagline}</p>
      </div>

      <div class="md:col-span-3">
        <h2 class="font-mono text-[10.5px] sm:text-[11.5px] tracking-[0.06em] text-ash/70">PAGES</h2>
        <ul class="mt-1.5 sm:mt-4 space-y-0.5 sm:space-y-2">
          {nav.map((item) => (
            <li><a href={item.href} class="textlink inline-block py-0.5 sm:py-1 font-mono text-[12px] sm:text-[12.5px] tracking-[0.04em] text-ash hover:text-volt">{item.label}</a></li>
          ))}
          <li><a href="/contact" class="textlink inline-block py-0.5 sm:py-1 font-mono text-[12px] sm:text-[12.5px] tracking-[0.04em] text-ash hover:text-volt">CONTACT</a></li>
        </ul>
      </div>

      <div class="md:col-span-4">
        <h2 class="font-mono text-[10.5px] sm:text-[11.5px] tracking-[0.06em] text-ash/70">GET IN TOUCH</h2>
        <ul class="mt-1.5 sm:mt-4 space-y-1 sm:space-y-2">
          <li><a href={`mailto:${site.email}`} class="textlink inline-block py-0.5 font-display text-[0.98rem] sm:text-[1.05rem] font-bold break-all sm:break-normal">{site.email}</a></li>
          <li><a href={`tel:${site.phoneHref}`} class="textlink inline-block py-0.5 font-mono text-[12.5px] sm:text-[13px] text-ash tnum">{site.phone}</a></li>
          {site.address && <li class="font-mono text-[11.5px] sm:text-[12px] text-ash pt-0.5">{site.address.toUpperCase()}</li>}
        </ul>
      </div>
    </div>

    <div class="mt-5 sm:mt-10 pt-4 sm:pt-6 border-t border-line flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 sm:gap-3 text-ash">
      <p class="font-mono text-[11px] sm:text-[12px] tnum">&copy; {year} {site.legalName.toUpperCase()}</p>
      <p class="font-mono text-[11px] sm:text-[12px]">AMSTERDAM</p>
    </div>
  </div>
</footer>
