---
import Base from '../layouts/Base.astro';
import Marquee from '../components/Marquee.astro';
import ServiceRows from '../components/ServiceRows.astro';
import ContactSection from '../components/ContactSection.astro';
import { site, projects, processSteps, stats } from '../data/site';
---

<Base
  title={`${site.name} - We build the systems you run on`}
  description={site.tagline}
>

  <!-- HERO : kinetic type with ambient looping video background -->
  <section class="relative min-h-[auto] sm:min-h-[100dvh] flex flex-col justify-center pt-20 sm:pt-28 lg:pt-32 pb-8 sm:pb-12 overflow-hidden">
    <!-- Ambient tech network background video -->
    <div class="absolute inset-0 pointer-events-none select-none overflow-hidden z-0" aria-hidden="true">
      <video
        autoplay
        loop
        muted
        playsinline
        preload="auto"
        poster="/videos/hero-poster.webp"
        class="hero-bg-video absolute inset-0 w-full h-full object-cover opacity-[0.22] sm:opacity-[0.28] transition-opacity duration-1000"
      >
        <source src="https://raw.githubusercontent.com/wofile123/videos/main/hero-bg.mp4" type="video/mp4" />
      </video>

      <!-- Soft gradient masks: seamlessly blend video edges into void (#0B0B0C) -->
      <div class="absolute inset-0 bg-gradient-to-b from-[#0B0B0C]/80 via-transparent to-[#0B0B0C]"></div>
      <div class="absolute inset-0 bg-radial from-transparent via-[#0B0B0C]/35 to-[#0B0B0C]/90"></div>
    </div>

    <div class="relative z-10 mx-auto max-w-shell w-full px-4 sm:px-6 lg:px-10">
      <h1 id="h1" class="font-display font-black tracking-[-0.045em] leading-[0.88] text-[clamp(2.15rem,min(13.2vw,20.5vh),10.75rem)]">
        <span class="line"><span class="spot">WE BUILD</span></span>
        <span class="line"><span class="outline-type">THE SYSTEMS</span></span>
        <span class="line"><span class="spot">YOU RUN ON.</span></span>
      </h1>

      <div class="mt-5 sm:mt-10 grid grid-cols-1 md:grid-cols-12 gap-5 sm:gap-8 items-end">
        <p class="tint rv md:col-span-5 text-[14.5px] sm:text-[16.5px] text-ash leading-relaxed max-w-[42ch]">
          Websites, custom software, and AI agents for companies that outgrew the spreadsheet.
        </p>
        <div class="rv rv-d1 md:col-span-4 md:col-start-9 flex md:justify-end">
          <a href="/contact" class="group inline-flex items-center justify-between sm:justify-start w-full sm:w-auto gap-3 bg-volt text-void font-display font-bold text-[14px] sm:text-[15px] pl-5 sm:pl-7 pr-2 py-2 sm:py-2.5 rounded-full stroke-btn hover:bg-white transition-colors duration-200">
            Start a project
            <span class="w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-void/12 grid place-items-center transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-[1px]" style="transition-timing-function:var(--ease-out)">
              <svg width="13" height="13" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2.5 9.5 9.5 2.5M4 2.5h5.5V8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <Marquee />

  <!-- SERVICES : numbered index rows -->
  <section id="services" class="py-8 sm:py-16 lg:py-36">
    <div class="mx-auto max-w-shell px-4 sm:px-6 lg:px-10">
      <h2 class="spot rv font-display font-black tracking-[-0.045em] text-[clamp(1.75rem,6vw,4.5rem)] leading-[0.92] max-w-[14ch]">
        THREE WAYS WE GET INVOLVED
      </h2>
      <div class="mt-5 sm:mt-12 lg:mt-16">
        <ServiceRows />
      </div>
      <a href="/services" class="rv mt-5 sm:mt-8 inline-flex items-center gap-2 font-mono text-[11.5px] sm:text-[12.5px] tracking-[0.05em] text-volt hover:text-chalk transition-colors duration-200">
        HOW WE WORK ON EACH
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2.5 9.5 9.5 2.5M4 2.5h5.5V8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
  </section>

  <!-- WORK : Mobile / Tablet (< 1024px) : Touch swipe carousel, ZERO vertical gap -->
  <section id="work" class="lg:hidden py-8 sm:py-14 border-t border-line">
    <div class="mx-auto max-w-shell w-full px-4 sm:px-6 mb-4 sm:mb-6 flex items-baseline justify-between">
      <h2 class="spot font-display font-black tracking-[-0.045em] text-[clamp(1.65rem,4.5vw,2.5rem)] leading-[0.95]">
        RECENT BUILDS
      </h2>
      <a href="/work" class="font-mono text-[11px] sm:text-[12px] tracking-[0.05em] text-volt hover:text-chalk transition-colors duration-200 inline-flex items-center gap-1">
        ALL BUILDS
        <svg width="11" height="11" viewBox="0 0 12 12" fill="none"><path d="M2.5 9.5 9.5 2.5M4 2.5h5.5V8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
    <div class="flex gap-4 overflow-x-auto snap-x snap-mandatory px-4 sm:px-6 pb-2 no-scrollbar" style="-webkit-overflow-scrolling: touch;">
      {projects.map((p) => (
        <article class="w-[82vw] sm:w-[48vw] shrink-0 snap-start flex flex-col justify-between">
          <div>
            <a href={p.url || '/work'} target={p.url ? '_blank' : undefined} rel={p.url ? 'noopener noreferrer' : undefined} class="group block">
              <div class="aspect-[16/10] overflow-hidden bg-pitch border border-line/60">
                <img src={p.image} alt={p.alt} width="1200" height="750" loading="lazy" decoding="async" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
              </div>
              <div class="mt-3 flex items-baseline justify-between gap-2">
                <h3 class="spot font-display text-[1.15rem] sm:text-[1.2rem] font-black tracking-[-0.03em] group-hover:text-volt transition-colors duration-200">{p.client}</h3>
                <span class="font-mono text-[10px] sm:text-[10.5px] text-volt/80 tracking-wider shrink-0">{p.sector.split(' ')[0]}</span>
              </div>
              <p class="tint mt-1 text-[13px] sm:text-[13.5px] text-ash leading-relaxed line-clamp-2">{p.summary}</p>
            </a>
          </div>
          {p.url && (
            <div class="mt-3 pt-2 border-t border-line/40">
              <a href={p.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 font-mono text-[11px] sm:text-[12px] text-volt hover:text-white transition-colors duration-200">
                VISIT LIVE SITE
                <svg width="10" height="10" viewBox="0 0 12 12" fill="none"><path d="M2.5 9.5 9.5 2.5M4 2.5h5.5V8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </div>
          )}
        </article>
      ))}
      <article class="w-[72vw] sm:w-[38vw] shrink-0 snap-start flex flex-col justify-between border border-line bg-pitch/80 p-5 sm:p-6">
        <div>
          <span class="font-mono text-[10px] sm:text-[10.5px] text-volt tracking-widest">ARCHIVE</span>
          <h3 class="spot mt-1.5 sm:mt-2 font-display text-[1.15rem] sm:text-[1.25rem] font-black tracking-[-0.03em] leading-tight">EXPLORE ALL BUILDS</h3>
          <p class="tint mt-1 text-[12px] sm:text-[12.5px] text-ash leading-relaxed">Full scope breakdowns and delivered metrics.</p>
        </div>
        <div class="mt-4 sm:mt-5">
          <a href="/work" class="inline-flex items-center gap-1.5 bg-volt text-void font-display font-bold text-[12.5px] sm:text-[13px] px-3.5 sm:px-4 py-1.5 sm:py-2 rounded-full stroke-btn">
            View All Work
            <svg width="11" height="11" viewBox="0 0 12 12" fill="none"><path d="M2.5 9.5 9.5 2.5M4 2.5h5.5V8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </article>
    </div>
  </section>

  <!-- WORK : Desktop (>= 1024px) : Cinematic scroll-driven horizontal pan -->
  <section class="hidden lg:block relative">
    <div id="panWrap" class="relative h-[200vh]">
      <div class="sticky top-0 h-[100dvh] flex flex-col justify-center overflow-hidden">
        <div class="mx-auto max-w-shell w-full px-6 lg:px-10 mb-6 flex items-baseline justify-between">
          <h2 class="spot font-display font-black tracking-[-0.045em] text-[clamp(1.75rem,4.5vw,3.2rem)] leading-[0.95]">
            RECENT BUILDS
          </h2>
          <a href="/work" class="font-mono text-[12.5px] tracking-[0.05em] text-volt hover:text-chalk transition-colors duration-200 inline-flex items-center gap-1.5">
            ALL BUILDS
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2.5 9.5 9.5 2.5M4 2.5h5.5V8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
        <div id="panTrack" class="pan-track gap-6 px-6 lg:px-10">
          {projects.map((p) => (
            <article class="w-[35vw] shrink-0 flex flex-col justify-between">
              <div>
                <a href={p.url || '/work'} target={p.url ? '_blank' : undefined} rel={p.url ? 'noopener noreferrer' : undefined} class="group block">
                  <div class="aspect-[4/3] overflow-hidden bg-pitch border border-line/60">
                    <img src={p.image} alt={p.alt} width="1200" height="900" loading="eager" decoding="async" class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105" />
                  </div>
                  <div class="mt-4 flex items-baseline justify-between gap-2">
                    <h3 class="spot font-display text-[1.35rem] font-black tracking-[-0.03em] group-hover:text-volt transition-colors duration-200">{p.client}</h3>
                    <span class="font-mono text-[11px] text-volt/80 tracking-wider shrink-0">{p.sector.split(' ')[0]}</span>
                  </div>
                  <p class="tint mt-2 text-[14.5px] text-ash leading-relaxed max-w-[44ch]">{p.summary}</p>
                </a>
              </div>
              {p.url && (
                <div class="mt-4 pt-3 border-t border-line/40">
                  <a href={p.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 font-mono text-[12.5px] text-volt hover:text-white transition-colors duration-200">
                    VISIT LIVE SITE
                    <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2.5 9.5 9.5 2.5M4 2.5h5.5V8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </a>
                </div>
              )}
            </article>
          ))}
          <article class="w-[26vw] shrink-0 flex flex-col justify-center border border-line bg-pitch/80 p-8">
            <span class="font-mono text-xs text-volt tracking-widest">ARCHIVE</span>
            <h3 class="spot mt-3 font-display text-[1.5rem] font-black tracking-[-0.03em] leading-tight">EXPLORE ALL BUILDS</h3>
            <p class="tint mt-2.5 text-[13px] text-ash leading-relaxed">Full scope breakdowns, architecture metrics, and delivered outcomes.</p>
            <div class="mt-6">
              <a href="/work" class="inline-flex items-center gap-2 bg-volt text-void font-display font-bold text-[13.5px] px-5 py-2.5 rounded-full stroke-btn hover:bg-white transition-colors duration-200">
                View All Work
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2.5 9.5 9.5 2.5M4 2.5h5.5V8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </div>
          </article>
        </div>
      </div>
    </div>
  </section>

  <!-- STATS : oversized figures -->
  <section class="py-8 sm:py-14 lg:py-24 border-y border-line">
    <div class="mx-auto max-w-shell px-4 sm:px-6 lg:px-10 grid grid-cols-2 lg:grid-cols-4 gap-x-4 sm:gap-x-8 gap-y-5 sm:gap-y-10">
      {stats.map((s, i) => (
        <div class:list={['rv', i === 1 && 'rv-d1', i === 2 && 'rv-d2', i === 3 && 'rv-d3']}>
          <div class="spot font-display font-black tracking-[-0.045em] text-[clamp(2rem,6vw,4.5rem)] leading-none tnum">{s.value}</div>
          <p class="tint mt-1.5 sm:mt-3 font-mono text-[10.5px] sm:text-[11.5px] text-ash tracking-[0.05em]">{s.label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- PROCESS : full-bleed image with overlaid stepped text -->
  <section id="process" class="relative py-8 sm:py-16 lg:py-36 overflow-hidden">
    <div class="absolute inset-0">
      <img src="https://images.unsplash.com/photo-1504384308090-c894fdcc538d?auto=format&fit=crop&w=2000&q=80"
           alt="" width="2000" height="1333" loading="lazy" decoding="async" class="w-full h-full object-cover opacity-[0.3]" />
      <div class="absolute inset-0" style="background:linear-gradient(180deg,#0B0B0C,rgba(11,11,12,.62),#0B0B0C)"></div>
    </div>
    <div class="relative mx-auto max-w-shell px-4 sm:px-6 lg:px-10">
      <h2 class="spot rv font-display font-black tracking-[-0.045em] text-[clamp(1.75rem,6vw,4.5rem)] leading-[0.92] max-w-[13ch]">
        HOW THE WORK RUNS
      </h2>
      <div class="mt-5 sm:mt-10 lg:mt-14 grid grid-cols-1 md:grid-cols-2 gap-x-10 lg:gap-x-14 gap-y-4 sm:gap-y-8 lg:gap-y-10">
        {processSteps.map((step, i) => (
          <div class:list={['rv border-t border-line pt-3.5 sm:pt-5 lg:pt-6', i === 1 && 'rv-d1', i === 2 && 'rv-d2', i === 3 && 'rv-d3']}>
            <h3 class="spot font-display text-[1.15rem] sm:text-[1.4rem] font-black tracking-[-0.03em]">{step.title}</h3>
            <p class="tint mt-2 sm:mt-3 text-[13.5px] sm:text-[15px] text-ash leading-relaxed max-w-[48ch]">{step.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <ContactSection />

  <script>
    // Horizontal pan: rAF-throttled, transform only, honors reduced motion.
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const wrap = document.getElementById('panWrap');
    const track = document.getElementById('panTrack');

    if (wrap && track) {
      let ticking = false;
      let distance = 0;

      const measure = () => {
        const pad = window.innerWidth >= 1024 ? 40 : (window.innerWidth >= 640 ? 24 : 16);
        distance = Math.max(0, track.scrollWidth - window.innerWidth + pad);
      };

      const update = () => {
        ticking = false;
        if (reduce.matches) {
          track.style.transform = 'none';
          return;
        }
        const rect = wrap.getBoundingClientRect();
        const total = wrap.offsetHeight - window.innerHeight;
        if (total <= 0) return;
        const p = Math.min(1, Math.max(0, -rect.top / total));
        track.style.transform = `translate3d(${-p * distance}px,0,0)`;
      };

      const onScroll = () => {
        if (!ticking) { ticking = true; requestAnimationFrame(update); }
      };

      measure();
      update();
      window.addEventListener('load', () => { measure(); update(); });
      track.querySelectorAll('img').forEach((img) => {
        if (!img.complete) {
          img.addEventListener('load', () => { measure(); update(); }, { once: true });
        }
      });
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', () => { measure(); update(); }, { passive: true });
      reduce.addEventListener('change', () => { measure(); update(); });
    }

    // Hero background video: ensure smooth autoplay & reduced motion compliance
    const heroVid = document.querySelector<HTMLVideoElement>('.hero-bg-video');
    if (heroVid) {
      if (reduce.matches) {
        heroVid.pause();
      } else {
        heroVid.play().catch(() => {});
      }
      reduce.addEventListener('change', () => {
        if (reduce.matches) {
          heroVid.pause();
        } else {
          heroVid.play().catch(() => {});
        }
      });
    }
  </script>
</Base>
