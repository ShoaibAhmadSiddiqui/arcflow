---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactSection from '../components/ContactSection.astro';
import { site, projects } from '../data/site';
---

<Base
  title={`Work - ${site.name}`}
  description="Recent builds: ERP rollouts, field service apps, client portals, and production planning systems."
>
  <PageHeader
    title="WORK WE CAN POINT AT."
    lede="Four recent builds. Each replaced something that had stopped working."
  />

  {projects.map((p, i) => (
    <section class:list={['py-16 lg:py-24', i > 0 && 'border-t border-line']}>
      <div class="mx-auto max-w-shell px-6 lg:px-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
          <div class:list={['lg:col-span-7', i % 2 === 1 && 'lg:order-2']}>
            <div class="aspect-[16/10] overflow-hidden bg-pitch">
              <img src={p.image} alt={p.alt} width="1200" height="750" loading="lazy" decoding="async" class="w-full h-full object-cover" />
            </div>
          </div>

          <div class:list={['lg:col-span-5', i % 2 === 1 && 'lg:order-1']}>
            <p class="font-mono text-[12px] tracking-[0.06em] text-volt">{p.sector}</p>
            <h2 class="spot mt-4 font-display font-black tracking-[-0.045em] text-[clamp(1.7rem,3.8vw,2.8rem)] leading-[0.94]">
              {p.client}
            </h2>
            <p class="tint mt-5 text-[15.5px] text-ash leading-relaxed max-w-[46ch]">{p.detail}</p>

            <dl class="mt-9 grid grid-cols-3 gap-5 border-t border-line pt-6">
              {p.metrics.map((m) => (
                <div>
                  <dt class="sr-only">{m.label}</dt>
                  <dd>
                    <span class="spot block font-display text-[1.7rem] font-black tracking-[-0.04em] tnum">{m.value}</span>
                    <span class="tint mt-1.5 block font-mono text-[11.5px] text-ash tracking-[0.05em]">{m.label}</span>
                  </dd>
                </div>
              ))}
            </dl>
          </div>
        </div>
      </div>
    </section>
  ))}

  <ContactSection />
</Base>
