---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactSection from '../components/ContactSection.astro';
import { site, projects } from '../data/site';
---

<Base
  title={`Work - ${site.name}`}
  description="Recent builds: agentic workflows, field service apps, client portals, and production planning systems."
>
  <PageHeader
    title="WORK WE CAN POINT AT."
    lede="Four recent builds. Each replaced something that had stopped working."
  />

  {projects.map((p, i) => (
    <section class:list={['py-7 sm:py-14 lg:py-24', i > 0 && 'border-t border-line']}>
      <div class="mx-auto max-w-shell px-4 sm:px-6 lg:px-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 sm:gap-8 lg:gap-14 items-center">
          <div class:list={['lg:col-span-7', i % 2 === 1 && 'lg:order-2']}>
            <a href={p.url || '#'} target={p.url ? '_blank' : undefined} rel={p.url ? 'noopener noreferrer' : undefined} class="group block aspect-[16/10] overflow-hidden bg-pitch border border-line/60">
              <img src={p.image} alt={p.alt} width="1200" height="750" loading="lazy" decoding="async" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
            </a>
          </div>

          <div class:list={['lg:col-span-5', i % 2 === 1 && 'lg:order-1']}>
            <p class="font-mono text-[10.5px] sm:text-[12px] tracking-[0.06em] text-volt">{p.sector}</p>
            <h2 class="spot mt-2 sm:mt-3 font-display font-black tracking-[-0.045em] text-[clamp(1.4rem,3.8vw,2.8rem)] leading-[0.94]">
              {p.client}
            </h2>
            <p class="tint mt-2 sm:mt-4 text-[13.5px] sm:text-[15.5px] text-ash leading-relaxed max-w-[46ch]">{p.detail}</p>

            {p.url && (
              <div class="mt-4 sm:mt-5">
                <a href={p.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-volt text-void font-display font-bold text-[13px] sm:text-[14px] px-5 py-2.5 rounded-full stroke-btn hover:bg-white transition-colors duration-200">
                  Visit Live Site
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2.5 9.5 9.5 2.5M4 2.5h5.5V8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
              </div>
            )}

            <dl class="mt-4 sm:mt-8 grid grid-cols-2 sm:grid-cols-3 gap-3 sm:gap-5 border-t border-line pt-3.5 sm:pt-6">
              {p.metrics.map((m) => (
                <div>
                  <dt class="sr-only">{m.label}</dt>
                  <dd>
                    <span class="spot block font-display text-[clamp(1.25rem,4.5vw,1.7rem)] font-black tracking-[-0.04em] tnum leading-tight">{m.value}</span>
                    <span class="tint mt-1 sm:mt-1.5 block font-mono text-[10px] sm:text-[11.5px] text-ash tracking-[0.05em]">{m.label}</span>
                  </dd>
                </div>
              ))}
            </dl>
          </div>
        </div>
      </div>
    </section>
  ))}

  <ContactSection />
</Base>
