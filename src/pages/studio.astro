---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactSection from '../components/ContactSection.astro';
import { site, stats, processSteps } from '../data/site';
---

<Base
  title={`Studio - ${site.name}`}
  description="A small engineering studio. No account layer between you and the people writing the code."
>
  <PageHeader
    title="A SMALL STUDIO THAT SHIPS."
    lede="No account layer between you and the engineers. The people in the room during scoping are the people who build it."
  />

  <section class="py-16 lg:py-20 border-b border-line">
    <div class="mx-auto max-w-shell px-6 lg:px-10 grid grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-10">
      {stats.map((s, i) => (
        <div class:list={['rv', i === 1 && 'rv-d1', i === 2 && 'rv-d2', i === 3 && 'rv-d3']}>
          <div class="spot font-display font-black tracking-[-0.045em] text-[clamp(2.2rem,5vw,3.8rem)] leading-none tnum">{s.value}</div>
          <p class="tint mt-3 font-mono text-[11.5px] text-ash tracking-[0.05em]">{s.label}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="py-20 lg:py-28">
    <div class="mx-auto max-w-shell px-6 lg:px-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        <div class="lg:col-span-5">
          <div class="lg:sticky lg:top-32">
            <div class="aspect-[4/5] overflow-hidden bg-pitch">
              <img
                src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=1000&q=80"
                alt="The studio team in discussion around a desk"
                width="1000" height="1250" loading="lazy" decoding="async"
                class="w-full h-full object-cover"
              />
            </div>
          </div>
        </div>

        <div class="lg:col-span-6 lg:col-start-7 space-y-12">
          <div class="rv">
            <h2 class="spot font-display text-[1.5rem] font-black tracking-[-0.035em]">WHAT WE DO</h2>
            <p class="tint mt-4 text-[15.5px] text-ash leading-relaxed max-w-[54ch]">
              We build the systems companies run on. Sometimes that is a website, more often it is the software behind it: the tool that tracks stock, the portal customers log into, the ERP that finally replaces nine spreadsheets and a whiteboard.
            </p>
          </div>
          <div class="rv rv-d1">
            <h2 class="spot font-display text-[1.5rem] font-black tracking-[-0.035em]">HOW WE ARE SET UP</h2>
            <p class="tint mt-4 text-[15.5px] text-ash leading-relaxed max-w-[54ch]">
              Small on purpose. Every project has a lead engineer who stays on it from scoping to support, so nobody has to re-explain the business on week six.
            </p>
          </div>
          <div class="rv rv-d2">
            <h2 class="spot font-display text-[1.5rem] font-black tracking-[-0.035em]">WHAT WE WILL TELL YOU</h2>
            <p class="tint mt-4 text-[15.5px] text-ash leading-relaxed max-w-[54ch]">
              If a project should not happen, we say so before you spend money on it. If an off-the-shelf product already does the job, we will name it. We would rather lose the work than build something that gets switched off in a year.
            </p>
          </div>
          <div class="rv rv-d3">
            <h2 class="spot font-display text-[1.5rem] font-black tracking-[-0.035em]">WHERE WE WORK</h2>
            <p class="tint mt-4 text-[15.5px] text-ash leading-relaxed max-w-[54ch]">
              Mostly with operations teams in logistics, manufacturing, and financial services. Industries where the software has to keep running when the people using it are busy, tired, and holding a scanner.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 lg:py-28 border-t border-line">
    <div class="mx-auto max-w-shell px-6 lg:px-10">
      <h2 class="spot font-display font-black tracking-[-0.045em] text-[clamp(1.8rem,4.2vw,3rem)] leading-[0.95] max-w-[20ch]">
        HOW A PROJECT RUNS
      </h2>
      <div class="mt-12 border-t border-line">
        {processSteps.map((step) => (
          <div class="rv grid grid-cols-1 md:grid-cols-12 gap-3 md:gap-8 py-7 border-b border-line">
            <h3 class="spot md:col-span-3 font-display text-[1.2rem] font-black tracking-[-0.03em]">{step.title}</h3>
            <p class="tint md:col-span-8 text-[15px] text-ash leading-relaxed max-w-[60ch]">{step.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <ContactSection />
</Base>
